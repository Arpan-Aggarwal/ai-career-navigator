# ─── Core Django ─────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-50-char-secret-key-here

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── CORS (Frontend URLs allowed to call the API) ────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Database ────────────────────────────────────────────
# Leave blank for SQLite (development)
# Set to Neon PostgreSQL URL for production:
# postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ─── Groq AI ─────────────────────────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Google OAuth (optional) ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (optional - for password reset) ───────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=noreply@careernavigator.ai

# ─── Frontend URL (for password reset links) ─────────────
FRONTEND_URL=http://localhost:5173
